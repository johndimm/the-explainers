{
  "name": "explainer-claude",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate-wikipedia": "tsx src/scripts/generate-wikipedia-data.ts",
    "build:pwa": "next build",
    "build:native": "BUILD_NATIVE=true next build",
    "setup:android": "npx cap add android",
    "setup:ios": "npx cap add ios", 
    "build:android": "npm run build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:dev": "./scripts/build-dev.sh",
    "build:android:vercel": "./scripts/build-vercel.sh",
    "build:ios": "npm run build:native && npm run setup:ios && npx cap sync ios && npx cap build ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "sync": "npx cap sync",
    "sync:dev": "npx cap sync --config=capacitor.config.dev.ts",
    "sync:vercel": "npx cap sync --config=capacitor.config.vercel.ts"
  },
  "keywords": [],
