{
  "name": "explainer-claude",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate-wikipedia": "tsx src/scripts/generate-wikipedia-data.ts",
    "build:pwa": "next build",
    "build:native": "BUILD_NATIVE=true next build",
    "setup:android": "npx cap add android",
    "setup:ios": "npx cap add ios",
    "build:android": "npm run build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:dev": "./scripts/build-dev.sh",
    "build:android:vercel": "./scripts/build-vercel.sh",
    "build:romeo-and-juliet": "./scripts/build-romeo-and-juliet.sh",
    "build:full-app": "./scripts/build-full-app.sh",
    "icon:custom": "node scripts/generate-android-custom-icon.js",
    "build:web:romeo-and-juliet": "cp src/config/romeo-and-juliet.ts src/config/app-config.ts && cp capacitor.config.romeo-and-juliet.ts capacitor.config.ts && npm run build",
    "build:web:full-app": "cp capacitor.config.full-app.ts capacitor.config.ts && npm run build",
    "build:ios": "npm run build:native && npm run setup:ios && npx cap sync ios && npx cap build ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "sync": "npx cap sync",
    "sync:dev": "npx cap sync --config=capacitor.config.dev.ts",
    "sync:vercel": "npx cap sync --config=capacitor.config.vercel.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@auth/core": "^0.34.2",
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "next": "^14.2.5",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "canvas": "^3.2.0",
    "sharp": "^0.34.4",
    "svg2png": "^4.1.1"
  }
}
